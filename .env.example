# ==========================================================
# Settings for this install. The easy way to make your .env:
#   ./scripts/setup.sh        (writes one with random secrets)
# Or by hand:  cp .env.example .env  and change the marked values.
# .env is gitignored and holds secrets: never commit or share it.
# ==========================================================

# --- How the app is run ---
# Leave unset to run on its own at http://localhost:8080. Or pick one:
#   Development on your desktop (hot reload, local ports):
#COMPOSE_FILE=docker-compose.yaml:docker-compose.dev.yml
#   Behind a Traefik reverse proxy (HTTPS on a domain name; see the README):
#COMPOSE_FILE=docker-compose.yaml:docker-compose.traefik.yml
#   Ready-made images of a release instead of building (setup.sh sets this
#   and APP_TAG; behind Traefik add :docker-compose.traefik.yml as well):
#COMPOSE_FILE=docker-compose.yaml:docker-compose.release.yml
# The release to run, with the release file above; scripts/update.sh moves it on
#APP_TAG=1.0.0

# --- Where the app is reached ---
# Running on its own: the address in your browser, and which port and
# network interface it listens on. 127.0.0.1 = this computer only; 0.0.0.0 =
# your whole network (then set DOMAIN_NAME to this machine's IP or name).
DOMAIN_NAME=localhost
SITE_URL=http://localhost:8080
APP_BIND=127.0.0.1
APP_PORT=8080
# Behind a reverse proxy, define the domain once and build the rest from it
# (BASE_DOMAIN must come first; SITE_URL then defaults to https://DOMAIN_NAME):
#   BASE_DOMAIN=example.com
#   DOMAIN_NAME=finance.${BASE_DOMAIN}
#   AUTH_DOMAIN=https://auth.${BASE_DOMAIN}
# In development the app is at http://localhost:5173:
#   SITE_URL=http://localhost:5173

# --- Database (the bundled Postgres container) ---
DB_NAME=finance
DB_USER=finance
DB_PASSWORD=change-me            # CHANGE: any long random string
DB_HOST=finance_db
DB_PORT=5432

# --- Django ---
# CHANGE: any long random string; generate with: openssl rand -hex 32
SECRET_KEY=change-me
# True only in development: shows error details in the browser
DEBUG=False

# --- Django admin ---
# Off unless asked for (on in development: DEBUG=True without OIDC). Users
# and passwords are managed in Settings → Users, so it's rarely needed.
#ENABLE_ADMIN=False

# --- Updates ---
# Where the app is installed on this machine (setup.sh fills it in), so
# Settings shows the exact update command to paste.
#INSTALL_DIR=/home/you/finance
# The GitHub repository whose releases the app checks once a day (switch it
# on or off in Settings → Storage; nothing is installed by the app: you run
# scripts/update.sh). Set it empty for no checking at all.
#UPDATE_CHECK_REPO=free-the-software/self-hosted-household-finance
# Running a changed version for other people? The AGPL asks you to offer them
# your changed source: point the menu's "Source code" link at it (then
# rebuild the frontend). Empty: the project's own repository.
#SOURCE_URL=
# Defaults for settings an admin can also change in Settings → Storage:
# the low disk warning (GB), idle sign-out (minutes) and largest upload (MB).
#DISK_WARN_GB=5

# --- Signing in ---
# How long a sign-in lasts, in seconds (default 12 hours), and how many
# minutes without activity before being signed out (default 10; 0 = never;
# an admin can also change this one in Settings → Storage).
#SESSION_COOKIE_AGE=43200
#SESSION_IDLE_MINUTES=10
# Served over HTTPS, browsers are told to use only HTTPS for this address for
# a year (HSTS). 0 turns that off.
#HSTS_SECONDS=31536000

# --- Folders and names ---
# Where the app keeps its files on this machine (default ./data), and the
# start of its container names (default "finance"). Change both to run a
# second copy on one machine.
#DATA_DIR=./data
#CONTAINER_PREFIX=finance

# --- Receipt reader (optional add-on, BETA) ---
# Reads photos of receipts and suggests the transaction each belongs to; it
# often misreads, and nothing changes until you approve it. Needs about 2.5 GB
# more disk and about 2 GB more memory while reading; the first build takes
# 10 minutes or more. Add or remove it with ./scripts/receipt-reader.sh on|off
# (which sets this line), or uncomment it and run: docker compose up -d --build
#COMPOSE_PROFILES=receipts
# The memory is released after this many minutes without a receipt
# (0 = keep it loaded, for faster reads).
#RECEIPT_READER_IDLE_MINUTES=10

# --- New installs ---
# A brand-new, empty ledger gets a starter set of categories. Set False for
# a blank slate. An existing ledger is never touched either way.
#STARTER_CATEGORIES=True

# --- Uploads ---
# Largest file the upload box accepts, in megabytes (default 25). Only bank
# files (.qfx .ofx .csv) and receipt images (.png .jpg .jpeg .heic) are accepted.
#UPLOAD_MAX_MB=25

# --- Rate limits ---
# A backstop against scripts hammering the server, set well above what the
# app's own pages use. Each is "number/period" (second, minute, hour, day);
# set one to nothing (RATE_LIMIT_USER=) to turn it off.
#RATE_LIMIT_VISITOR=60/minute    # requests made without being signed in, per address
#RATE_LIMIT_USER=600/minute      # everything one signed-in user does
#RATE_LIMIT_UPLOADS=120/minute   # files sent to the upload box
#RATE_LIMIT_HEAVY=20/hour        # backups and storage clean-ups started by hand
#RATE_LIMIT_SIGN_IN=30/minute    # sign-in attempts, per address
# How many reverse proxies are in front of the backend (Traefik counts as one).
# Set to 0 if the backend is reached directly.
#NUM_PROXIES=1

# --- Backups ---
# Folder on the host where backup files are written. Leave unset to keep them
# in ./data/backups; point it at another disk or a mounted share for real
# protection against a disk failure. Schedule and encryption are set in the
# app, under Settings > Backups.
#BACKUP_DIR_HOST=/mnt/backup-disk/finance

# --- Single sign-on: OIDC / Authentik (optional) ---
# Blank = log in with the password login made by setup.sh (or createsuperuser).
# See "Authentication" in the README for the Authentik setup.
AUTH_DOMAIN=
OIDC_APP_SLUG=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# At each sign-in, the identity provider asks for the password (and second
# factor) again, so signing out here really signs you out. If your provider
# also asks by itself and people end up signing in twice, set this to False.
#OIDC_FORCE_LOGIN=True
# With the OIDC values set, the Django admin (/admin) and password login are
# switched off, so sign-in can only happen through your identity provider.
# Uncomment to keep the admin as well:
#ENABLE_ADMIN=True
